              },
              "experiment": {
                "aggregations": [],
                "operation": "groupby"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "edl_tenant": 0,
              "experiment": 1,
              "Value #A (min)": 2,
              "Value #B (max)": 3,
              "Cluster (count)": 4,
              "Cluster (allValues)": 5
