        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(1000 * min by (cluster, edl_tenant, experiment) (min_over_time(timestamp(count by (cluster, edl_tenant, experiment) (up{experiment!=\"\"}))[$lookback:${resolution}s]) or label_replace(label_replace(label_replace(min_over_time(timestamp(count by (cluster, __tenant_id__) (up{experiment=\"\"}))[$lookback:${resolution}s]), \"edl_tenant\", \"$1\", \"__tenant_id__\", \"(.+)\"), \"edl_tenant\", \"${home_tenant}\", \"edl_tenant\", \"\"), \"experiment\", \"$1\", \"cluster\", \"(.+)\")), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
