{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "${logs_datasource}"
        },
        "enable": true,
        "expr": "{source=\"annotation\", cluster=~\"${cluster:regex}\"} | dashboard_uid=\"\"",
        "hide": false,
        "iconColor": "green",
        "instant": false,
        "name": "easy-db-lab markers",
        "tagKeys": "tags",
        "textFormat": "",
        "titleFormat": "{{cluster}}"
      }
    ]
  },
  "description": "Every test (cluster) of the tenant the Metrics picker selects, with its window, links to its dashboards, and its documents. A test's window is its first and last `up` sample in Mimir within Lookback, so torn-down clusters are listed too.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "description": "One row per cluster with `up` samples within Lookback. Start and End are the first and last `up` sample, found at the Resolution step, so the window is the whole life of the cluster. Click a cluster for its dashboards, a comparison with the current cluster, or its documents.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cluster"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cluster"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "System Overview",
                    "url": "/d/system-overview/system-overview?var-cluster=${__data.fields.cluster}&from=${__data.fields.window_start}&to=${__data.fields.window_end}&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${doc_tenant:queryparam}"
                  },
                  {
                    "title": "Cassandra Overview",
                    "url": "/d/1e7b6436-9a13-44cf-bdae-7528a9a7f537/cassandra-overview?var-cluster=${__data.fields.cluster}&from=${__data.fields.window_start}&to=${__data.fields.window_end}&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${doc_tenant:queryparam}"
                  },
                  {
                    "title": "Compare with the current cluster",
                    "url": "/d/c09599ec-8d87-4fe5-9346-9e85c41d33af/cluster-comparison?var-baseline_cluster=${__data.fields.cluster}&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${cluster:queryparam}&${doc_tenant:queryparam}&${lookback:queryparam}"
                  },
                  {
                    "title": "Show documents",
                    "url": "/d/tests/tests?var-cluster=${__data.fields.cluster}&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${doc_tenant:queryparam}&${lookback:queryparam}&${resolution:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Start|End"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurationms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "window_start|window_end"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource}"
          },
          "editorMode": "code",
          "expr": "1000 * min by (cluster) (min_over_time(timestamp(count by (cluster) (up))[$lookback:${resolution}s]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource}"
          },
          "editorMode": "code",
          "expr": "1000 * max by (cluster) (max_over_time(timestamp(count by (cluster) (up))[$lookback:${resolution}s]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource}"
          },
          "editorMode": "code",
          "expr": "1000 * (min by (cluster) (min_over_time(timestamp(count by (cluster) (up))[$lookback:${resolution}s])) - $resolution)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics_datasource}"
          },
          "editorMode": "code",
          "expr": "1000 * (max by (cluster) (max_over_time(timestamp(count by (cluster) (up))[$lookback:${resolution}s])) + $resolution)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Tests",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Duration",
            "binary": {
              "left": "Value #B",
              "operator": "-",
              "right": "Value #A"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "cluster": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Duration": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "Value #A": "Start",
              "Value #B": "End",
              "Value #C": "window_start",
              "Value #D": "window_end"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "string",
                "targetField": "window_start"
              },
              {
                "destinationType": "string",
                "targetField": "window_end"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Start"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "The documents of the selected test, `reports/<doc_tenant>/<cluster>/index.html` in the account bucket, served read-only by the documents web server on the control node. Upload them with `easy-db-lab report upload FILE...`. A test that has none shows \"No documents yet\".",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<iframe src=\"__DOCUMENTS_URL__/reports/${doc_tenant}/${cluster}/index.html\" style=\"width: 100%; height: 100%; border: 0; background: #fff;\"></iframe>",
        "mode": "html"
      },
      "title": "Documents: ${cluster}",
      "type": "text"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "tests"
  ],
