  "description": "Every experiment of the tenant the Metrics picker selects, with its window, its clusters, links to its dashboards, and its report. An experiment's window runs from its clusters' first to their last `up` sample in Mimir within Lookback, so torn-down clusters are listed too. A cluster from before the experiment label is an experiment of one, named for the cluster.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "description": "One row per experiment with `up` samples within Lookback: its tenant, its name, the first start and last end of its clusters (found at the Resolution step), how many clusters it has, and their short names. A cluster from before the experiment label is its own experiment, with its tenant from Mimir's tenant (when the Metrics picker spans tenants) or the home tenant. Click an experiment for its newest report, Experiment: Cassandra on all of its clusters, or this dashboard on it.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "edl_tenant"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tenant"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "experiment"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Experiment"
              },
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Newest report",
                    "url": "__DOCUMENTS_URL__/reports/${__data.fields.edl_tenant}/${__data.fields.experiment}/index.html"
                  },
                  {
                    "title": "Compare clusters",
                    "url": "/d/c09599ec-8d87-4fe5-9346-9e85c41d33af/experiment-cassandra?var-experiment=${__data.fields.edl_tenant}/${__data.fields.experiment}&var-cluster=$__all&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${lookback:queryparam}&${resolution:queryparam}"
                  },
                  {
                    "title": "Show here",
                    "url": "/d/tests/tests?var-experiment=${__data.fields.edl_tenant}/${__data.fields.experiment}&var-cluster=$__all&${metrics_datasource:queryparam}&${logs_datasource:queryparam}&${traces_datasource:queryparam}&${lookback:queryparam}&${resolution:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "First start|Last end"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
