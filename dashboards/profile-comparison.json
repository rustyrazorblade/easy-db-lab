          ],
          "labelSelector": "{service_name=\"${service}\",${compare_by}=\"${side_a}\"}",
          "profileTypeId": "${profile_type}",
          "queryType": "metrics",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
