    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "How many SSTables a read has to merge. Every extra SSTable is another seek and another bloom filter check, so this rises directly into the local read latency above. A value of 0 means the read was answered from the memtable. A p99 that climbs while max stays flat means the workload is spreading a partition across more files; check compaction. This family publishes p50, p99, and max ONLY. There is no p999 series, so this panel names the three percentiles explicitly rather than following the $percentile variable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "SSTables",
            "axisPlacement": "auto",
