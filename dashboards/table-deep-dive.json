          "expr": "max by (cluster, host_name) (cassandra_client_request_latency_${percentile}_microseconds{job=\"cassandra\", cluster=~\"$cluster\", host_name=~\"$host\", cassandra_operation=\"read\"}) / ${latency_unit} - max by (cluster, host_name) (cassandra_table_read_latency_${percentile}_microseconds{job=\"cassandra\", cluster=~\"$cluster\", host_name=~\"$host\", keyspace=~\"$keyspace\", table=~\"$table\"}) / ${latency_unit}",
