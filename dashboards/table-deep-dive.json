          },
          "editorMode": "code",
          "expr": "max by (cluster, host_name) (cassandra_table_read_latency_${percentile}_microseconds{job=\"cassandra\", cluster=~\"$cluster\", host_name=~\"$host\", keyspace=~\"$keyspace\", table=~\"$table\"}) / ${latency_unit}",
          "instant": false,
          "legendFormat": "{{host_name}} local table read",
          "range": true,
