    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "How many deleted cells a read has to walk past before it can answer. This is the single most common cause of a slow read on an otherwise healthy table. Tombstones only register AFTER a flush: the histogram counts what a read scans out of SSTables, so deletes still sitting in the memtable show nothing here. If you have just deleted data and this panel is flat, flush the table and look again. The default warn threshold is 1000 per read and the failure threshold is 100000.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
