#!/bin/bash
#
# Installs a single Cassandra version into /usr/local/cassandra/<version>.
#
# Run by the CLI over SSH (`cassandra install`, `cassandra use`, node replacement). The CLI
# resolves the version (its source, URLs and cache object) and passes everything as arguments, so
# this script looks nothing up.
#
# Usage:
#   install-cassandra-version <name> --url URL [--fallback-url URL] [--cache-uri URI] [--reinstall]
#   install-cassandra-version <name> --url GIT_URL --branch B --java N [--ant-flags F] [--reinstall]
#
#   --url tarball (https:// or s3://) -> download and unpack it; with --cache-uri, through the
#                                       download cache (an Apache release), else from its origin
#   --url + --branch                  -> git clone the branch and build it with ant on JDK --java
#
# Re-running for an already-installed version is a no-op, unless --reinstall: then the new install
# is built beside the old one and replaces it only when it is complete.

set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: install-cassandra-version <name> --url URL [options]

Options:
  --url URL           Tarball URL (https:// or s3://) or git repository URL (with --branch); required
  --fallback-url URL  Second tarball URL, tried when --url fails (with --cache-uri)
  --cache-uri URI     Download-cache object for the tarball (an Apache release only)
  --branch BRANCH     Git branch to clone and build
  --java VERSION      JDK major version used for the ant build (e.g. 8, 11, 17, 21, 25)
  --ant-flags FLAGS   Extra flags passed to ant (e.g. "-Duse.jdk11=true")
  --reinstall         Install again over an existing install, replacing it only on success
USAGE
}

VERSION=""
URL=""
FALLBACK_URL=""
CACHE_URI=""
REINSTALL=""
BRANCH=""
JAVA_VERSION=""
ANT_FLAGS=""

# need_value OPTION ARGC - refuses OPTION when it is the last argument, so set -u never stops the
# script with an unbound-variable error that names no option.
need_value() {
    if [[ "$2" -lt 2 ]]; then
        echo "ERROR: $1 needs a value" >&2
        usage >&2
        exit 1
    fi
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --url) need_value "$1" $#; URL="$2"; shift 2 ;;
            --fallback-url) need_value "$1" $#; FALLBACK_URL="$2"; shift 2 ;;
            --cache-uri) need_value "$1" $#; CACHE_URI="$2"; shift 2 ;;
            --reinstall) REINSTALL=1; shift ;;
            --branch) need_value "$1" $#; BRANCH="$2"; shift 2 ;;
            --java) need_value "$1" $#; JAVA_VERSION="$2"; shift 2 ;;
            --ant-flags) need_value "$1" $#; ANT_FLAGS="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            --*) echo "ERROR: unknown option $1" >&2; usage >&2; exit 1 ;;
            *)
                if [ -z "$VERSION" ]; then
                    VERSION="$1"; shift
                else
                    echo "ERROR: unexpected argument $1" >&2; usage >&2; exit 1
                fi
                ;;
        esac
    done

    if [ -z "$VERSION" ]; then
        echo "ERROR: <version> is required" >&2
        usage >&2
        exit 1
    fi

    # The version names a directory this script moves and deletes as root: one safe path segment.
    # The CLI checks the same pattern (VersionName) before it calls the node.
    if [[ ! "$VERSION" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
        echo "ERROR: invalid version name [$VERSION]: use letters, digits, ., _, + and -, starting with a letter or a digit" >&2
        exit 1
    fi

    if [ -z "$URL" ]; then
        echo "ERROR: --url is required for $VERSION; the CLI resolves the version and passes its URL" >&2
        exit 1
    fi

    if [[ -n "$BRANCH" && ( -n "$CACHE_URI" || -n "$FALLBACK_URL" ) ]]; then
        echo "ERROR: --cache-uri applies only to a tarball, not to a git build of $VERSION" >&2
        exit 1
    fi

    # A tarball is unpacked as-is; there is nothing to check a branch out of. Silently ignoring
    # --branch here would install something other than what was asked for.
    if [[ -n "$BRANCH" && "$URL" == *.tar.gz ]]; then
        echo "ERROR: --branch $BRANCH cannot be used with a tarball --url ($URL); pass a git repository URL" >&2
        exit 1
    fi

    # A git repository is not a tarball: downloading it would fail later with an unclear extract error.
    if [[ -z "$BRANCH" && "$URL" == *.git ]]; then
        echo "ERROR: $URL is a git repository; pass --branch to build $VERSION from it" >&2
        exit 1
    fi
}

# Written into every installed version's bin/cassandra.in.sh (OTel and AxonOps agents, GC logging,
# log dirs). Installed to this durable path by install_cassandra.sh at bake time so a runtime install
# can find it too - /tmp does not survive a reboot.
CASSANDRA_IN_SH_SNIPPET=${CASSANDRA_IN_SH_SNIPPET:-/usr/local/share/easy-db-lab/cassandra.in.sh}

# Where versions land. Overridable so the script can be exercised outside a node.
CASSANDRA_INSTALL_DIR=${CASSANDRA_INSTALL_DIR:-/usr/local/cassandra}

# Private working directory for this run, removed on every exit path — not just the successful
# one. A failed git clone leaves the credentialed remote behind in <workdir>/<version>/.git/config,
# and a failed build is the common case when testing an unmerged branch.
# A failed --reinstall also removes its staging directory, so the old install is all that remains.
WORKDIR=""
STAGING=""
trap 'cd /; [ -n "$WORKDIR" ] && rm -rf "$WORKDIR"; [ -n "$STAGING" ] && sudo rm -rf "$STAGING"' EXIT

# The download cache helpers (cached_fetch_uri). Only the URI the CLI passes names the cache; the
# bake-time config the library also reads is never used here. Overridable so the tests can load the
# repo copy of the lib.
EDL_CACHE_LIB=${EDL_CACHE_LIB:-/usr/local/lib/edl-cache.sh}
# shellcheck disable=SC1090
source "$EDL_CACHE_LIB"

# direct_fetch <url> <dest>
# Fetch <url> from its origin, never through the download cache. An s3:// url (a `cassandra build`
# artifact) is copied straight from S3, as curl has no s3 protocol.
direct_fetch() {
    local url="$1" dest="$2"
    echo "direct download (not cached): $url"
    case "$url" in
        s3://*) aws s3 cp "$url" "$dest" --no-progress ;;
        *) curl -fsSL --retry 3 "$url" -o "$dest" ;;
    esac
}

## Resolves JAVA_HOME for a JDK major version. The build must use the JDK the version declares,
## never the node's current default alternative, and must not change that default - switching it
## would disturb whichever Cassandra version is currently active on the node.
resolve_java_home() {
    local java_version="$1"
    local arch
    arch=$(dpkg --print-architecture)

    local candidate
    for candidate in \
        "/usr/lib/jvm/java-${java_version}-openjdk-${arch}" \
        "/usr/lib/jvm/java-1.${java_version}.0-openjdk-${arch}"; do
        if [ -x "$candidate/bin/java" ]; then
            echo "$candidate"
            return 0
        fi
    done

    echo "ERROR: No JDK found on this node for java version $java_version" >&2
    return 1
}

## Fetches the tarball into the current directory as <archive>: through the download cache when
## the CLI gave a cache object, else from its origin.
fetch_tarball() {
    local archive="$1"
    if [ -n "$CACHE_URI" ]; then
        cached_fetch_uri "$CACHE_URI" "$archive" "$URL" "$FALLBACK_URL"
    else
        direct_fetch "$URL" "$archive"
    fi
}

## Installs a single Cassandra version end-to-end: download (or git build), place under
## /usr/local/cassandra/$version, and apply the per-version configuration. With --reinstall the
## version is staged in /usr/local/cassandra/.<version>.new and swapped in only when complete.
##
## Safe to run as a background job: it operates in its own private temp working directory
## (so concurrent versions never share extraction state, e.g. the `find . -name '*cassandra*'`
## below only ever sees its own tarball) and otherwise writes only version-specific paths.
## Genuinely shared/global steps (user + directory creation, the Maven cache cleanup) are the
## caller's responsibility.
install_cassandra_version() {
  local version="$1"
  # Where this run builds the install: the final directory, or a staging one for --reinstall.
  local target="$CASSANDRA_INSTALL_DIR/$version"

  if [[ -d "$target" && -z "$REINSTALL" ]]; then
    echo "Version $version is already installed at $target, nothing to do"
    return 0
  fi
  if [[ -n "$REINSTALL" ]]; then
    target="$CASSANDRA_INSTALL_DIR/.$version.new"
    STAGING="$target"
    sudo rm -rf "$target"
  fi

  if [[ ! -f "$CASSANDRA_IN_SH_SNIPPET" ]]; then
      echo "ERROR: Missing $CASSANDRA_IN_SH_SNIPPET, cannot configure version $version" >&2
      return 1
  fi

  # Script-scoped, not local: the EXIT trap below runs after this function has returned.
  WORKDIR=$(mktemp -d) || {
      echo "ERROR: Failed to create temp working directory for version $version" >&2
      return 1
  }

  cd "$WORKDIR" || {
      echo "ERROR: Cannot change to working directory $WORKDIR for version $version" >&2
      return 1
  }

  echo "Configuring version: $version"

  sudo mkdir -p "$CASSANDRA_INSTALL_DIR"

  # A tarball. A nightly url (5.0-HEAD, 6.0-HEAD, trunk) serves a new build under the same name,
  # so the CLI gives no --cache-uri for it and it is fetched from its origin on every install;
  # only an Apache release, which never changes, comes with a cache object.
  if [[ -z "$BRANCH" ]]; then
    echo "Downloading $URL for version $version"

    local archive_file
    archive_file=$(basename "$URL")

    fetch_tarball "$archive_file" || {
        echo "ERROR: Failed to download version $version from: $URL${FALLBACK_URL:+ $FALLBACK_URL}" >&2
        return 1
    }

    # Verify download succeeded and file is not empty
    if [[ ! -f "$archive_file" || ! -s "$archive_file" ]]; then
        echo "ERROR: Downloaded file $archive_file is missing or empty for version $version" >&2
        return 1
    fi

    # gzip begins with the bytes 1f 8b; a URL that gives anything else (a repository page) is no tarball.
    if [[ "$(head -c 2 "$archive_file" | od -An -tx1 | tr -d ' \n')" != "1f8b" ]]; then
        echo "ERROR: $URL is not a gzip tarball; for a git repository pass --branch to build $version from it" >&2
        return 1
    fi

    echo "Extracting $archive_file"
    tar zxf "$archive_file" || {
        echo "ERROR: Failed to extract $archive_file for version $version" >&2
        return 1
    }

    rm -f "$archive_file"

    # Find the extracted directory (should be the only directory created)
    # Look for directories starting with 'apache-cassandra' or 'cassandra'
    local f
    f=$(find . -mindepth 1 -maxdepth 1 -type d -name '*cassandra*' | head -n 1)
    f="${f#./}"

    # Verify extracted directory exists
    if [[ -z "$f" || ! -d "$f" ]]; then
        echo "ERROR: Could not find extracted Cassandra directory for version $version" >&2
        echo "Available directories:"
        ls -la
        return 1
    fi

    echo "Found extracted directory: $f"

    sudo mv "$f" "$target" || {
        echo "ERROR: Failed to move $f to $target" >&2
        return 1
    }

  else
    # Clone the git repo specified by --url, check out --branch, and build it with ant.
    if [[ -z "$JAVA_VERSION" ]]; then
        echo "ERROR: Building version $version from source requires --java" >&2
        return 1
    fi

    local java_home
    java_home=$(resolve_java_home "$JAVA_VERSION") || return 1
    echo "Building version $version with JDK $JAVA_VERSION at $java_home"

    echo "Cloning repo for version $version from $URL branch $BRANCH"
    git clone --depth=1 --single-branch --branch "$BRANCH" "$URL" "$version" || {
        echo "ERROR: Git clone failed for version $version from $URL branch $BRANCH" >&2
        return 1
    }

    # Verify clone was successful
    if [[ ! -d "$version/.git" ]]; then
        echo "ERROR: Git clone incomplete for version $version - .git directory not found" >&2
        return 1
    fi

    echo "Building version $version with ant"
    # Per-version build log so concurrent builds do not clobber a shared file.
    local ant_log="/tmp/ant-build-$version.log"
    (
      cd "$version" || exit 1
      export JAVA_HOME="$java_home"
      export PATH="$java_home/bin:$PATH"
      # Quiet: ant output is voluminous and floods packer's SSH stream
      # shellcheck disable=SC2086
      ant realclean >"$ant_log" 2>&1 && ant -Dcheck.skip=true -Dant.gen-doc.skip=true $ANT_FLAGS >>"$ant_log" 2>&1 || exit 1
      rm -rf .git
    ) || {
        echo "ERROR: Ant build failed for version $version, see $ant_log" >&2
        tail -n 50 "$ant_log" >&2 || true
        return 1
    }

    sudo mv "$version" "$target" || {
        echo "ERROR: Failed to move built version $version to $target" >&2
        return 1
    }
  fi

  # Verify the version was successfully moved into place
  if [[ ! -d "$target" ]]; then
      echo "ERROR: Version $version not found in $CASSANDRA_INSTALL_DIR/ after installation" >&2
      return 1
  fi

  # at this point the $version is in place, however it was installed
  # do any general customizations in the below subshell
  echo "Configuring version $version"
  (
      cd "$target" || exit 1
      rm -rf data
      cp -R conf conf.orig
      # create a pristine backup of the original conf
      sudo cp conf/cassandra.yaml conf/cassandra.orig.yaml
      cat "$CASSANDRA_IN_SH_SNIPPET" >> bin/cassandra.in.sh
  ) || {
      # Leave nothing behind: the directory's existence is what marks a version installed, so a
      # half-configured one would make every retry a no-op.
      sudo rm -rf "$target"
      echo "ERROR: Configuration failed for version $version" >&2
      return 1
  }

  # Remove bundled cqlsh from Cassandra 2.x and 3.x to use uv-installed version
  if [[ "$version" == 2.* || "$version" == 3.* ]]; then
    echo "Removing bundled cqlsh from Cassandra $version (using uv-installed version instead)"
    rm -f "$target/bin/cqlsh"
    rm -f "$target/bin/cqlsh.py"
  fi

  sudo chown -R cassandra:cassandra "$target"

  if [[ -n "$REINSTALL" ]]; then
    # Swap: the old install moves aside, the new one takes its name, then the old one goes.
    local old="$CASSANDRA_INSTALL_DIR/.$version.old"
    sudo rm -rf "$old"
    if [[ -d "$CASSANDRA_INSTALL_DIR/$version" ]]; then
      sudo mv "$CASSANDRA_INSTALL_DIR/$version" "$old"
    fi
    sudo mv "$target" "$CASSANDRA_INSTALL_DIR/$version" || {
        [[ -d "$old" ]] && sudo mv "$old" "$CASSANDRA_INSTALL_DIR/$version"
        echo "ERROR: Failed to put the reinstalled $version in place; the old install is kept" >&2
        return 1
    }
    STAGING=""
    sudo rm -rf "$old"
  fi

  echo "✓ Successfully installed and configured version $version"
}

# Sourced by the unit tests for the functions above; then nothing here runs.
if [ -z "${INSTALL_CASSANDRA_VERSION_SOURCE_ONLY:-}" ]; then
    parse_args "$@"
    install_cassandra_version "$VERSION"
fi
