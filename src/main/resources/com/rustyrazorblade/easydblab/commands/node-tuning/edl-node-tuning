#!/bin/sh
#
# easy-db-lab node tuning: the settings no config file persists, and a read-back of all of them.
#
#   edl-node-tuning apply              transparent huge pages, CPU governor and idle states,
#                                      disk scheduler and readahead, and packet steering on every
#                                      physical network interface. Run by edl-node-tuning.service
#                                      at boot and at setup. The udev disk rule sets the disk
#                                      values too, for a disk attached later; apply sets them
#                                      itself so the boot verify does not depend on when udev
#                                      finishes processing its coldplug events.
#   edl-node-tuning rps <iface>        packet steering on one interface. Run by udev when a
#                                      physical interface appears, such as a secondary ENI the
#                                      CNI attaches later.
#   edl-node-tuning rps-queue <path>   packet steering again on the interface that owns the
#                                      receive queue at sysfs path <path>. Run by udev when a
#                                      receive queue is added or removed (ethtool -L).
#   edl-node-tuning verify             reads back every value node setup applies. Prints one
#                                      "ERROR: <setting>: wanted <x>, got <y>" line per mismatch
#                                      and exits 1 when there is any.
#
# CPU frequency and idle states are tuned only where the instance exposes them; otherwise apply
# logs one line naming the node, the instance type and what it skipped, and carries on. The
# instance type is EDL_INSTANCE_TYPE, else the value setup wrote to /etc/default/edl-node-tuning
# from the cluster state.
#
# Every line it prints also goes to the journal under the edl-node-tuning tag. When systemd runs
# it, its output already is the journal, so each line is written there once.
#
# The paths are overridable only so edl-node-tuning.test.sh can run this against a fake sysfs.

SYS="${EDL_SYS_ROOT:-/sys}"
PROC="${EDL_PROC_ROOT:-/proc}"
SYSCTL_CONF="${EDL_SYSCTL_CONF:-/etc/sysctl.d/60-easydblab.conf}"
DEFAULTS="${EDL_DEFAULTS:-/etc/default/edl-node-tuning}"

THP_ENABLED=madvise
THP_DEFRAG=never
GOVERNOR=performance
RPS_FLOW_ENTRIES=32768
MIN_KERNEL_FILES=1048576
SERVICE_NOFILE=1048576
DISK_READAHEAD_KB=4
DISK_SCHEDULER=none

# The units node setup gives the service limits, when they are installed on this node.
LIMITED_UNITS="cassandra k3s k3s-agent"

# Sends [line] to the journal under the edl-node-tuning tag, unless the output already goes there
# (systemd sets JOURNAL_STREAM for a unit whose output is the journal).
journal() {
  [ -z "${JOURNAL_STREAM:-}" ] && command -v logger > /dev/null 2>&1 && logger -t edl-node-tuning "$1"
  return 0
}

say() {
  echo "edl-node-tuning: $*"
  journal "$*"
}

# The node's instance type as node setup read it from the cluster state: EDL_INSTANCE_TYPE, else
# the value setup wrote to $DEFAULTS, else "unknown instance type".
instance_type() {
  found="${EDL_INSTANCE_TYPE:-$(sed -n 's/^EDL_INSTANCE_TYPE=//p' "$DEFAULTS" 2> /dev/null)}"
  echo "${found:-unknown instance type}"
}

skip() {
  say "skipped $1 on $(hostname): $(instance_type) $2"
}

# Writes [value] to [file]; a write the kernel refuses is reported by verify, not here. The group
# carries the redirect so the shell's own error, from opening [file], is silenced too, and a failed
# write prints only the one line below.
put() {
  { echo "$2" > "$1"; } 2> /dev/null || say "could not write $2 to $1"
}

# The CPU numbers in a kernel CPU list such as 0-3,8,10-11, one per line.
cpu_numbers() {
  echo "$1" | tr ',' '\n' | while IFS=- read -r first last; do
    [ -z "$first" ] && continue
    n=$first
    while [ "$n" -le "${last:-$first}" ]; do
      echo "$n"
      n=$((n + 1))
    done
  done
}

# The RPS mask that covers every online CPU, in the kernel's comma-grouped 32-bit hex words:
# 2 CPUs give 3, 33 give 1,ffffffff.
rps_mask() {
  cpus=$(cpu_numbers "$(cat "$SYS/devices/system/cpu/online")")
  max=0
  for c in $cpus; do [ "$c" -gt "$max" ] && max=$c; done
  word=$((max / 32))
  mask=""
  while [ "$word" -ge 0 ]; do
    value=0
    for c in $cpus; do
      [ $((c / 32)) -eq "$word" ] && value=$((value | (1 << (c % 32))))
    done
    if [ -z "$mask" ]; then mask=$(printf '%x' "$value"); else mask="$mask,$(printf '%08x' "$value")"; fi
    word=$((word - 1))
  done
  echo "$mask"
}

# A mask without its separators and leading zeros, so the kernel's padded form compares equal.
normal_mask() {
  m=$(echo "$1" | tr -d ',' | sed 's/^0*//')
  echo "${m:-0}"
}

rx_queues() {
  ls -d "$SYS/class/net/$1/queues"/rx-* 2> /dev/null
}

# Each queue's share of the flow table, rounded up to a power of two: the kernel rounds
# rps_flow_cnt up that way and reads back the rounded value, so writing it already rounded makes
# the write and verify agree for any queue count (3 queues: 10922 becomes 16384).
flow_count() {
  count=$(rx_queues "$1" | wc -l)
  [ "$count" -gt 0 ] || count=1
  share=$((RPS_FLOW_ENTRIES / count))
  flows=1
  while [ "$flows" -lt "$share" ]; do flows=$((flows * 2)); done
  echo "$flows"
}

# The kernel announces a new interface before it creates its receive queues, so a call from udev
# waits briefly for them.
wait_for_queues() {
  tries=0
  while [ -z "$(rx_queues "$1")" ] && [ "$tries" -lt "${EDL_QUEUE_WAIT_TRIES:-20}" ]; do
    sleep 0.25
    tries=$((tries + 1))
  done
}

# Every receive queue of [iface] steers to every CPU, with its share of the flow table.
steer() {
  mask=$(rps_mask)
  flows=$(flow_count "$1")
  for q in $(rx_queues "$1"); do
    put "$q/rps_cpus" "$mask"
    put "$q/rps_flow_cnt" "$flows"
  done
}

rps() {
  iface="$1"
  [ -n "$iface" ] || { echo "usage: edl-node-tuning rps <iface>" >&2; return 1; }
  wait_for_queues "$iface"
  steer "$iface"
}

# A changed queue count (ethtool -L adds or removes rx-N queues and sends no event for the
# interface) changes every queue's flow share, so the whole interface is steered again. [path] is
# the queue's sysfs path, /devices/.../net/<iface>/queues/rx-N. When that interface no longer
# exists under that name (udev has renamed it since the queue appeared), its own add event steers
# it, and nothing is done here.
rps_queue() {
  path="$1"
  [ -n "$path" ] || { echo "usage: edl-node-tuning rps-queue <path>" >&2; return 1; }
  iface="${path%/queues/*}"
  iface="${iface##*/}"
  [ -d "$SYS/class/net/$iface/queues" ] || return 0
  steer "$iface"
}

# The physical network interfaces: every link with a device behind it (an ENA, gve or virtio NIC).
# Virtual links (lo, veth, cilium_*, lxc*, tailscale0) have none.
physical_links() {
  for link in "$SYS/class/net"/*; do
    [ -e "$link/device" ] && echo "${link##*/}"
  done
}

# The sysfs directory of every online CPU. A present but offline CPU has no cpufreq or cpuidle
# directory, so it is left out, as it is from the RPS mask.
cpus() {
  for n in $(cpu_numbers "$(cat "$SYS/devices/system/cpu/online")"); do
    echo "$SYS/devices/system/cpu/cpu$n"
  done
}

# The NVMe and Xen block disks, the ones the udev disk rule tunes.
disks() {
  for disk in "$SYS/block"/nvme*n* "$SYS/block"/xvd*; do
    [ -d "$disk/queue" ] && echo "$disk"
  done
}

# The exit latency of C1, the shallowest real idle state: the state named C1 (C1_ACPI or C1-<cpu>,
# such as C1-SKX, on some kernels), else the first state that is not POLL (HALT on an x86 VM, WFI on arm64, which has
# no POLL).
c1_latency() {
  for state in "$SYS/devices/system/cpu/cpu0/cpuidle"/state*; do
    case "$(cat "$state/name" 2> /dev/null)" in
      C1 | C1_ACPI | C1-*) cat "$state/latency"; return ;;
    esac
  done
  for state in "$SYS/devices/system/cpu/cpu0/cpuidle"/state*; do
    [ "$(cat "$state/name" 2> /dev/null)" = POLL ] && continue
    cat "$state/latency"
    return
  done
  echo 0
}

# The idle states of [cpu] deeper than C1, one directory per line.
deep_states() {
  c1=$(c1_latency)
  for state in "$1/cpuidle"/state*; do
    [ -f "$state/latency" ] || continue
    [ "$(cat "$state/latency")" -gt "$c1" ] && echo "$state"
  done
}

has_governor() {
  grep -qw "$GOVERNOR" "$SYS/devices/system/cpu/cpu0/cpufreq/scaling_available_governors" 2> /dev/null
}

has_idle_states() {
  [ -f "$SYS/devices/system/cpu/cpu0/cpuidle/state0/latency" ]
}

apply() {
  put "$SYS/kernel/mm/transparent_hugepage/enabled" "$THP_ENABLED"
  put "$SYS/kernel/mm/transparent_hugepage/defrag" "$THP_DEFRAG"

  if has_governor; then
    for cpu in $(cpus); do put "$cpu/cpufreq/scaling_governor" "$GOVERNOR"; done
  else
    skip "CPU governor" "exposes no frequency scaling"
  fi

  if has_idle_states; then
    for cpu in $(cpus); do
      for state in $(deep_states "$cpu"); do put "$state/disable" 1; done
    done
  else
    skip "CPU idle states" "exposes no idle states"
  fi

  for disk in $(disks); do
    put "$disk/queue/scheduler" "$DISK_SCHEDULER"
    put "$disk/queue/read_ahead_kb" "$DISK_READAHEAD_KB"
  done

  for iface in $(physical_links); do rps "$iface"; done
}

FAILED=0

# Prints and journals the ERROR line for setting [1]: wanted [2], got [3], and [4], what to do
# about it, when there is something to say.
mismatch() {
  line="ERROR: $1: wanted $2, got $3${4:+; $4}"
  echo "$line"
  journal "$line"
  FAILED=1
}

check() {
  [ "$3" = "$2" ] || mismatch "$1" "$2" "$3"
}

# The selected value of a sysfs choice such as "always [madvise] never", or the file's value when
# it holds just one.
selected() {
  value=$(cat "$1" 2> /dev/null)
  case "$value" in
    *\[*\]*) echo "$value" | sed 's/.*\[\(.*\)\].*/\1/' ;;
    *) echo "$value" ;;
  esac
}

read_sysctl() {
  tr -s '\t ' '  ' < "$PROC/sys/$(echo "$1" | tr . /)" 2> /dev/null
}

verify_sysctls() {
  grep -E '^[a-z]' "$SYSCTL_CONF" | while IFS='=' read -r key value; do
    key=$(echo "$key" | tr -d ' ')
    value=$(echo "$value" | sed 's/^ *//; s/ *$//' | tr -s ' ')
    actual=$(read_sysctl "$key")
    [ "$actual" = "$value" ] || mismatch "$key" "$value" "${actual:-nothing}"
  done
}

# Process [1]'s limit [2] ("open files", "locked memory") from its /proc limits: the soft value,
# followed by the hard one when the two differ.
process_limit() {
  awk -v name="Max $2" 'index($0, name) == 1 {
    split(substr($0, length(name) + 1), f, " ")
    print (f[1] == f[2] ? f[1] : f[1] " (hard " f[2] ")")
  }' "$PROC/$1/limits" 2> /dev/null
}

# A running service keeps the limits it started with, whatever its drop-in says now, so for an
# active unit [1] the limits are read from its main process. Nothing restarts it here.
verify_running_limits() {
  [ "$(systemctl show -p ActiveState --value "$1.service")" = active ] || return 0
  pid=$(systemctl show -p MainPID --value "$1.service")
  [ -n "$pid" ] && [ "$pid" != 0 ] || return 0
  for row in "open files:$SERVICE_NOFILE" "locked memory:unlimited"; do
    limit="${row%%:*}"
    wanted="${row#*:}"
    got=$(process_limit "$pid" "$limit")
    [ "$got" = "$wanted" ] ||
      mismatch "$1 running process $limit" "$wanted" "${got:-nothing}" "restart $1 to apply"
  done
}

verify() {
  # verify_sysctls reads in a pipeline, a subshell that cannot set FAILED; its output tells.
  errors=$(verify_sysctls)
  if [ -n "$errors" ]; then
    echo "$errors"
    FAILED=1
  fi

  for key in fs.nr_open fs.file-max; do
    actual=$(read_sysctl "$key")
    [ -n "$actual" ] && [ "$actual" -ge "$MIN_KERNEL_FILES" ] ||
      mismatch "$key" "at least $MIN_KERNEL_FILES" "${actual:-nothing}"
  done

  check "transparent_hugepage/enabled" "$THP_ENABLED" "$(selected "$SYS/kernel/mm/transparent_hugepage/enabled")"
  check "transparent_hugepage/defrag" "$THP_DEFRAG" "$(selected "$SYS/kernel/mm/transparent_hugepage/defrag")"

  if has_governor; then
    for cpu in $(cpus); do
      check "${cpu##*/} scaling_governor" "$GOVERNOR" "$(cat "$cpu/cpufreq/scaling_governor" 2> /dev/null)"
    done
  fi
  if has_idle_states; then
    for cpu in $(cpus); do
      for state in $(deep_states "$cpu"); do
        check "${cpu##*/} idle ${state##*/} disable" 1 "$(cat "$state/disable" 2> /dev/null)"
      done
    done
  fi

  mask=$(normal_mask "$(rps_mask)")
  for iface in $(physical_links); do
    flows=$(flow_count "$iface")
    for q in $(rx_queues "$iface"); do
      check "$iface ${q##*/} rps_cpus" "$mask" "$(normal_mask "$(cat "$q/rps_cpus" 2> /dev/null)")"
      check "$iface ${q##*/} rps_flow_cnt" "$flows" "$(cat "$q/rps_flow_cnt" 2> /dev/null)"
    done
  done

  for disk in $(disks); do
    check "${disk##*/} scheduler" "$DISK_SCHEDULER" "$(selected "$disk/queue/scheduler")"
    check "${disk##*/} read_ahead_kb" "$DISK_READAHEAD_KB" "$(cat "$disk/queue/read_ahead_kb")"
  done

  swaps=$(($(wc -l < "$PROC/swaps") - 1))
  check "swap devices" 0 "$swaps"

  # irqbalance's unit has ConditionCPUs=>1: on one CPU there is nothing to balance and it stays
  # inactive by design.
  if [ "$(cpu_numbers "$(cat "$SYS/devices/system/cpu/online")" | wc -l)" -gt 1 ]; then
    check "irqbalance" active "$(systemctl is-active irqbalance 2> /dev/null)"
  else
    skip "irqbalance" "has one CPU"
  fi

  # Not enabled, the boot unit restores nothing after a reboot, and logs no drift line either.
  check "edl-node-tuning.service" enabled "$(systemctl is-enabled edl-node-tuning.service 2> /dev/null)"

  check "systemd DefaultLimitNOFILE" "$SERVICE_NOFILE" "$(systemctl show -p DefaultLimitNOFILE --value)"
  check "systemd DefaultLimitMEMLOCK" infinity "$(systemctl show -p DefaultLimitMEMLOCK --value)"
  for unit in $LIMITED_UNITS; do
    [ "$(systemctl show -p LoadState --value "$unit.service")" = loaded ] || continue
    check "$unit LimitNOFILE" "$SERVICE_NOFILE" "$(systemctl show -p LimitNOFILE --value "$unit.service")"
    check "$unit LimitMEMLOCK" infinity "$(systemctl show -p LimitMEMLOCK --value "$unit.service")"
    verify_running_limits "$unit"
  done

  return "$FAILED"
}

case "${1:-}" in
  apply) apply ;;
  rps) rps "${2:-}" ;;
  rps-queue) rps_queue "${2:-}" ;;
  verify) verify ;;
  *)
    echo "usage: edl-node-tuning apply | rps <iface> | rps-queue <path> | verify" >&2
    exit 2
    ;;
esac
