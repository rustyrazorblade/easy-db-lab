apiVersion: v1
kind: Service
metadata:
  name: cassandra-pods-gossip
  namespace: default
  labels:
    easydblab/kit: cassandra-pods
spec:
  # Headless: gives each pod a stable DNS name (cassandra-pods-0.cassandra-pods-gossip), which is
  # how every node finds the seed. Unready pods are published too, because a node only becomes
  # ready after it has gossiped with the seed.
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    app: cassandra-pods
  ports:
    - name: gossip
      port: 7000
      targetPort: 7000
