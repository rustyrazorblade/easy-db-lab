apiVersion: apps/v1
kind: StatefulSet
metadata:
  # kit-storage names the PV data-<kit>-<ordinal>; the StatefulSet's claim takes the same name
  # only when the StatefulSet is named after the kit and its claim template is `data`.
  name: cassandra-pods
  namespace: default
  labels:
    app: cassandra-pods
    easydblab/kit: cassandra-pods
spec:
  replicas: __CASSANDRA_NODES__
  serviceName: cassandra-pods-gossip
  # Nodes join one at a time (Cassandra does not support concurrent bootstraps), and an upgrade
  # restarts them one at a time, each waiting for the previous one to serve CQL again.
  podManagementPolicy: OrderedReady
  updateStrategy:
    type: RollingUpdate
  selector:
    matchLabels:
      app: cassandra-pods
  template:
    metadata:
      labels:
        app: cassandra-pods
        easydblab/kit: cassandra-pods
      annotations:
        # The ConfigMap's content and the artifact (lib/apply-statefulset.sh fills it from the
        # cassandra-artifact contributor), so a patch edit or a new tarball rolls the pods and a
        # start with nothing changed rolls nothing.
        easydblab/config-hash: "@EDL_CONFIG_HASH@"
    spec:
      terminationGracePeriodSeconds: 120
      nodeSelector: __DB_NODE_SELECTOR__
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  app: cassandra-pods
      # uid 999 is the cassandra user of the cassandra-runtime image (and of the AMI); fsGroup makes
      # the claim writable by it. Every container meets Pod Security "restricted".
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        # The OpenTelemetry Java agent comes from a pinned, multi-arch image, not from a host path,
        # so this works on any node. The image is the one Kotlin uses (JavaAgent.OTEL).
        - name: otel-agent
          image: "__OTEL_AGENT_IMAGE__"
          imagePullPolicy: IfNotPresent
          command: ["cp", "/javaagent.jar", "/agents/opentelemetry-javaagent.jar"]
          resources: {} # @EDL_INIT_RESOURCES@
          securityContext:
            runAsUser: 65532
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: java-agents
              mountPath: /agents
        # Puts the tarball into the claim's cache, checked against its sha256; a cached tree is
        # used with no network call.
        - name: cassandra-fetch
          image: "@EDL_RUNTIME_IMAGE@"
          imagePullPolicy: IfNotPresent
          command: ["sh", "/edl/config/fetch-tarball.sh"]
          env:
            - name: EDL_TARBALL_URL
              value: "@EDL_TARBALL_URL@"
            - name: EDL_TARBALL_FALLBACK_URL
              value: "@EDL_TARBALL_FALLBACK_URL@"
            - name: EDL_TARBALL_SHA256
              value: "@EDL_TARBALL_SHA256@"
            - name: EDL_CASSANDRA_BUILD
              value: "@EDL_CASSANDRA_BUILD@"
            - name: EDL_ARTIFACT_CACHE
              value: /var/lib/cassandra/.edl/artifacts
            - name: EDL_CASSANDRA_HOME
              value: /var/lib/cassandra/.edl/artifacts/sha256-@EDL_TARBALL_SHA256@
          resources: {} # @EDL_INIT_RESOURCES@
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: data
              mountPath: /var/lib/cassandra
            - name: config
              mountPath: /edl/config
              readOnly: true
        # Builds this pod's cassandra.yaml with the VM path's merge (tarball, workspace patch,
        # placement, the pod's addresses), plus cassandra.in.sh and the rackdc file.
        - name: cassandra-render
          image: "@EDL_RUNTIME_IMAGE@"
          imagePullPolicy: IfNotPresent
          command: ["sh", "/edl/config/render-config.sh"]
          env:
            - name: EDL_CASSANDRA_HOME
              value: /var/lib/cassandra/.edl/artifacts/sha256-@EDL_TARBALL_SHA256@
            - name: CASSANDRA_CONF
              value: /edl/conf
            - name: POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: HOST_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
          resources: {} # @EDL_INIT_RESOURCES@
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: data
              mountPath: /var/lib/cassandra
              readOnly: true
            - name: config
              mountPath: /edl/config
              readOnly: true
            - name: conf
              mountPath: /edl/conf
      containers:
        - name: cassandra
          image: "@EDL_RUNTIME_IMAGE@"
          imagePullPolicy: IfNotPresent
          # cassandra-env.sh sizes the heap from the host's memory (free -m), not the container
          # limit, so the heap is always set here. --heap, validated at start to fit inside
          # --memory, wins; otherwise half the limit, leaving the rest for off-heap memory,
          # metaspace and the agent. The young generation is a quarter of the heap, in MiB.
          command:
            - sh
            - -c
            - |
              if [ -n "$CASSANDRA_HEAP" ]; then
                size="${CASSANDRA_HEAP%[GgMm]}"
                case "$CASSANDRA_HEAP" in
                  *[Gg]) heap_mib=$((size * 1024)) ;;
                  *) heap_mib=$size ;;
                esac
              else
                heap_mib=$((MEMORY_LIMIT_MIB / 2))
              fi
              newsize=$((heap_mib / 4))
              [ "$newsize" -ge 1 ] || newsize=1
              export MAX_HEAP_SIZE="${heap_mib}M" HEAP_NEWSIZE="${newsize}M"
              exec "$EDL_CASSANDRA_HOME/bin/cassandra" -f
          env:
            - name: EDL_TARBALL_SHA256
              value: "@EDL_TARBALL_SHA256@"
            - name: EDL_CASSANDRA_BUILD
              value: "@EDL_CASSANDRA_BUILD@"
            - name: EDL_CASSANDRA_HOME
              value: /var/lib/cassandra/.edl/artifacts/sha256-@EDL_TARBALL_SHA256@
            - name: CASSANDRA_HOME
              value: /var/lib/cassandra/.edl/artifacts/sha256-@EDL_TARBALL_SHA256@
            - name: CASSANDRA_CONF
              value: /edl/conf
            # The rendered cassandra.in.sh: the tarball's own, then the packer snippet, which reads
            # the overrides below in place of the VM paths.
            - name: CASSANDRA_INCLUDE
              value: /edl/conf/cassandra.in.sh
            - name: ECL_AGENTS_LIB
              value: /edl/config/edl-cassandra-agents.sh
            - name: EDL_OTEL_AGENT_JAR
              value: /edl/agents/opentelemetry-javaagent.jar
            - name: EDL_OTEL_JMX_CONFIG
              value: /etc/edl-jmx/cassandra-jmx-rules.yaml
            # The core collector Service on port 4318, its OTLP http/protobuf receiver and the
            # agent's default protocol. The Service keeps the traffic on this pod's node.
            - name: EDL_OTLP_ENDPOINT
              value: "__OTEL_OTLP_HTTP_ENDPOINT__"
            - name: EDL_CASSANDRA_LOG_DIR
              value: /var/lib/cassandra/logs
            - name: CASSANDRA_HEAP
              value: "__CASSANDRA_HEAP__"
            # The container's own memory limit in MiB, for the default heap.
            - name: MEMORY_LIMIT_MIB
              valueFrom:
                resourceFieldRef:
                  containerName: cassandra
                  resource: limits.memory
                  divisor: 1Mi
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # host.name names the node, not the pod, so every signal matches the node-keyed
            # dashboard filters; the snippet keeps it through EDL_OTEL_EXTRA_RESOURCE_ATTRIBUTES.
            # NODE_NAME must precede this variable.
            - name: EDL_OTEL_EXTRA_RESOURCE_ATTRIBUTES
              value: "host.name=$(NODE_NAME)"
          # Drain flushes memtables and stops accepting writes before SIGTERM, so a restart replays
          # little commit log. The timeout keeps it inside terminationGracePeriodSeconds (120), and
          # `|| true` is acceptable only because the SIGTERM shutdown hook drains again right after.
          lifecycle:
            preStop:
              exec:
                command: ["sh", "-c", "timeout 100 \"$EDL_CASSANDRA_HOME/bin/nodetool\" drain || true"]
          ports:
            - name: cql
              containerPort: 30942
            - name: gossip
              containerPort: 7000
          # Memory request equals limit, so the scheduler places the pod only on a node where it
          # fits. CPU per GUARANTEED_PODS: request equals limit on owned nodes (with every init
          # container's), so the pod is Guaranteed; elsewhere a request and no CPU limit.
          resources: {} # @EDL_CASSANDRA_RESOURCES@
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - '"$EDL_CASSANDRA_HOME/bin/nodetool" statusbinary | grep -qx running'
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 60
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: data
              mountPath: /var/lib/cassandra
            - name: conf
              mountPath: /edl/conf
              readOnly: true
            - name: config
              mountPath: /edl/config
              readOnly: true
            - name: java-agents
              mountPath: /edl/agents
              readOnly: true
            - name: jmx-rules
              mountPath: /etc/edl-jmx
              readOnly: true
      volumes:
        - name: java-agents
          emptyDir: {}
        - name: conf
          emptyDir: {}
        - name: config
          configMap:
            name: cassandra-pods-config
        - name: jmx-rules
          configMap:
            name: cassandra-pods-jmx-rules
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app: cassandra-pods
          easydblab/kit: cassandra-pods
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: "__KIT_STORAGE_CLASS__"
        resources:
          requests:
            storage: "__STORAGE_SIZE__"
