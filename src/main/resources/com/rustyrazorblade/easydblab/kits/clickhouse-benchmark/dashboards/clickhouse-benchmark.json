      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
          "expr": "label_replace(clickhouse_benchmark_rows_per_second{cluster=~\"$cluster\", kit=~\"$kit\"}, \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{kit}}",
          "refId": "A"
        }
      ],
      "title": "Rows per Second",
      "type": "timeseries"
    },
