  "refresh": "",
  "schemaVersion": 38,
  "tags": ["clickhouse", "clickhouse-benchmark", "benchmark"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "metrics_datasource",
        "query": "prometheus",
        "refresh": 1,
        "regex": "Mimir",
        "type": "datasource"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
        "definition": "label_values(up, cluster)",
        "description": "The clusters this dashboard shows. Clusters of one tenant share one store, so every query filters by this variable.",
        "hide": 0,
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": { "qryType": 1, "query": "label_values(up, cluster)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "/^(?<value>(?<text>.+?)(?:-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?)$/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
        "definition": "label_values(clickhouse_benchmark_qps{cluster=~\"$cluster\"}, kit)",
        "description": "The kit instances this dashboard shows.",
        "hide": 0,
        "includeAll": true,
        "label": "Kit",
        "multi": true,
        "name": "kit",
        "query": { "query": "label_values(clickhouse_benchmark_qps{cluster=~\"$cluster\"}, kit)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ClickHouse Benchmark",
  "uid": "clickhouse-benchmark",
