apiVersion: "clickhouse-keeper.altinity.com/v1"
kind: "ClickHouseKeeperInstallation"
metadata:
  name: clickhouse-keeper
  namespace: default
spec:
  # The operator applies a pod template only when one is referenced; without this the Keeper
  # pods got neither the db-only affinity nor the instance label below.
  defaults:
    templates:
      podTemplate: clickhouse-keeper-pod
  configuration:
    settings:
      # Keeper serves no Prometheus endpoint unless enabled. 7000 is clear of its client (2181),
      # raft (9444) and http_control (9182) ports; kit.yaml scrapes it by pod discovery.
      prometheus/endpoint: /metrics
      prometheus/port: 7000
      prometheus/metrics: true
      prometheus/events: true
      prometheus/asynchronous_metrics: true
    clusters:
      - name: keeper
        layout:
          replicasCount: __REPLICAS__
  templates:
    podTemplates:
      - name: clickhouse-keeper-pod
        metadata:
          labels:
            app.kubernetes.io/instance: clickhouse
        spec:
          affinity:
            nodeAffinity:
              # Run Keeper on db nodes co-located with ClickHouse so the quorum
              # is on the same machines as the data it coordinates.
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: type
                        operator: In
                        values:
                          - db
