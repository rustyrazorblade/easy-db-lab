# The client listeners of the first FerrosaDB pod (ordinal 0) on fixed NodePorts of every node.
# Drivers that discover peers (CQL through system.peers) reach the other pods from there.
# Internode traffic (17000) has no NodePort.
# FerrosaDB CQL
apiVersion: v1
kind: Service
metadata:
  name: ferrosa-cql-nodeport
  namespace: default
  labels:
    easydblab/kit: ferrosa
spec:
  type: NodePort
  selector:
    easydblab/ferrosa-ordinal: "0"
  ports:
    - name: cql
      port: 9042
      targetPort: 9042
      nodePort: 30942
---
