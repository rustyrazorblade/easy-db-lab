{
  "uid": "ignite3-kit",
  "title": "Apache Ignite 3",
  "tags": ["ignite3", "kit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "metrics_datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
        "definition": "label_values(up, cluster)",
        "query": "label_values(up, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Cluster", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "type": "stat", "title": "Nodes",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "targets": [ { "expr": "max by (cluster) (TotalNodes{cluster=~\"$cluster\", otel_scope_name=\"topology.cluster\"})", "refId": "A" } ]
    },
    {
      "type": "stat", "title": "Healthy partitions",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [ { "expr": "sum by (cluster) (HealthyPartitionCount{cluster=~\"$cluster\", otel_scope_name=~\"partition.states.*\"})", "refId": "A" } ]
    },
    {
      "type": "stat", "title": "Broken partitions",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "sum by (cluster) (BrokenPartitionCount{cluster=~\"$cluster\", otel_scope_name=~\"partition.states.*\"})", "refId": "A" } ]
    },
    {
      "type": "stat", "title": "Unavailable partitions",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "sum by (cluster) (UnavailablePartitionCount{cluster=~\"$cluster\", otel_scope_name=~\"partition.states.*\"})", "refId": "A" } ]
    },

    { "type": "row", "title": "SQL", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },
    {
      "type": "timeseries", "title": "SQL query outcomes (rate)",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (rate(Succeeded{cluster=~\"$cluster\", otel_scope_name=\"sql.queries\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} succeeded", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(Failed{cluster=~\"$cluster\", otel_scope_name=\"sql.queries\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} failed", "refId": "B" },
        { "expr": "label_replace(sum by (cluster) (rate(Canceled{cluster=~\"$cluster\", otel_scope_name=\"sql.queries\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} canceled", "refId": "C" },
        { "expr": "label_replace(sum by (cluster) (rate(TimedOut{cluster=~\"$cluster\", otel_scope_name=\"sql.queries\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} timed out", "refId": "D" }
      ]
    },
    {
      "type": "timeseries", "title": "SQL plan cache (rate)",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (rate(Hits{cluster=~\"$cluster\", otel_scope_name=\"sql.plan.cache\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} hits", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(Misses{cluster=~\"$cluster\", otel_scope_name=\"sql.plan.cache\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} misses", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Open cursors",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "targets": [ { "expr": "label_replace(sum by (cluster) (OpenCursors{cluster=~\"$cluster\", otel_scope_name=\"sql.client\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} open cursors", "refId": "A" } ]
    },

    { "type": "row", "title": "Transactions", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Commits (rate)",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (rate(RwCommits{cluster=~\"$cluster\", otel_scope_name=\"transactions\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} read-write", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(RoCommits{cluster=~\"$cluster\", otel_scope_name=\"transactions\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} read-only", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Rollbacks (rate)",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (rate(RwRollbacks{cluster=~\"$cluster\", otel_scope_name=\"transactions\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} read-write", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(RoRollbacks{cluster=~\"$cluster\", otel_scope_name=\"transactions\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} read-only", "refId": "B" }
      ]
    },

    { "type": "row", "title": "Client handler", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Sessions",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (SessionsActive{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} active", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(SessionsAccepted{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} accepted/s", "refId": "B" },
        { "expr": "label_replace(sum by (cluster) (rate(SessionsRejected{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} rejected/s", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "title": "Requests",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (RequestsActive{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} active", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(RequestsProcessed{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} processed/s", "refId": "B" },
        { "expr": "label_replace(sum by (cluster) (rate(RequestsFailed{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} failed/s", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "title": "Network bytes (rate)",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "expr": "label_replace(sum by (cluster) (rate(BytesReceived{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} received", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) (rate(BytesSent{cluster=~\"$cluster\", otel_scope_name=\"client.handler\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} sent", "refId": "B" }
      ]
    },

    { "type": "row", "title": "Storage (aipersist)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Storage size by node",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "label_replace(TotalUsedSize{cluster=~\"$cluster\", otel_scope_name=\"storage.aipersist.default\"}, \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} used {{instance}}", "refId": "A" },
        { "expr": "label_replace(TotalAllocatedSize{cluster=~\"$cluster\", otel_scope_name=\"storage.aipersist.default\"}, \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} allocated {{instance}}", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Checkpoint duration",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "label_replace(LastCheckpointDuration{cluster=~\"$cluster\", otel_scope_name=\"storage.aipersist.checkpoint\"}, \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} total {{instance}}", "refId": "A" },
        { "expr": "label_replace(LastCheckpointFsyncDuration{cluster=~\"$cluster\", otel_scope_name=\"storage.aipersist.checkpoint\"}, \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} fsync {{instance}}", "refId": "B" }
      ]
    },

    { "type": "row", "title": "Thread pools", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "collapsed": false },
    {
      "type": "timeseries", "title": "Active threads by pool",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "targets": [
        { "expr": "label_replace(sum by (cluster, otel_scope_name) (ActiveCount{cluster=~\"$cluster\", otel_scope_name=~\"thread.pools.*\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} {{otel_scope_name}}", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) ({__name__=~\"stripe_[0-9]+_ActiveCount\", cluster=~\"$cluster\", otel_scope_name=\"thread.pools.sql-executor\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} thread.pools.sql-executor", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Queue size by pool",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "targets": [
        { "expr": "label_replace(sum by (cluster, otel_scope_name) (QueueSize{cluster=~\"$cluster\", otel_scope_name=~\"thread.pools.*\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} {{otel_scope_name}}", "refId": "A" },
        { "expr": "label_replace(sum by (cluster) ({__name__=~\"stripe_[0-9]+_QueueSize\", cluster=~\"$cluster\", otel_scope_name=\"thread.pools.sql-executor\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")", "legendFormat": "{{cluster_name}} thread.pools.sql-executor", "refId": "B" }
      ]
    }
  ]
}
