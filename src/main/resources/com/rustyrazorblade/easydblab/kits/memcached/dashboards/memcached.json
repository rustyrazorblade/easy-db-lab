    {
      "type": "row",
      "title": "Memory and Items",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 20,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Memory: RAM Used vs Limit",
      "description": "RAM used is the memory memcached has allocated for slab pages (memcached_malloced_bytes); it cannot exceed the limit (--memory). Item bytes is the full size of every stored item (memcached_current_bytes), including values moved to extstore on flash, so with extstore on it can be far above the limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 21,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by(instance) (memcached_current_bytes{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"})",
          "legendFormat": "item bytes (RAM + flash) {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by(instance) (memcached_malloced_bytes{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"})",
          "legendFormat": "RAM used {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sum by(instance) (memcached_limit_bytes{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"})",
          "legendFormat": "limit {{instance}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Current Items",
      "description": "Items currently stored, per instance",
      "datasource": {
        "type": "prometheus",
