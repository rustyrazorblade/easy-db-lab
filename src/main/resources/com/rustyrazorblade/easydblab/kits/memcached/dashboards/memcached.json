          "expr": "sum(rate(memcached_commands_total{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\", command=\"get\", status=\"miss\"}[$__rate_interval])) and on() sum(memcached_extstore_bytes_limit{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"})",
          "legendFormat": "misses",
          "refId": "C"
