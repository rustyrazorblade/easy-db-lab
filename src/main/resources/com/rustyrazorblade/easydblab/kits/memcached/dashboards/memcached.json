        }
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(memcached_items_evicted_total{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "evicted {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sum by(instance) (rate(memcached_items_reclaimed_total{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "reclaimed {{instance}}",
          "refId": "B"
        }
      ]
