        {
          "expr": "clamp_min(sum(rate(memcached_commands_total{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\", command=\"get\", status=\"hit\"}[$__rate_interval])) - sum(rate(memcached_extstore_objects_read_total{job=\"memcached\", cluster=~\"$cluster.*\", instance=~\"$instance\"}[$__rate_interval])), 0)",
          "legendFormat": "RAM hits",
          "refId": "B"
