    {
      "type": "timeseries",
      "title": "Evictions and Reclaims",
      "description": "Valid items evicted to free memory, and expired items whose memory was reused, per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "id": 24,
      "options": {
        "legend": {
          "displayMode": "list",
