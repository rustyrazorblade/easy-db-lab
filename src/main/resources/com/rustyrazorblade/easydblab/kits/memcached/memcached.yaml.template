apiVersion: apps/v1
kind: Deployment
metadata:
  name: memcached
  namespace: default
  labels:
    app: memcached
    easydblab/kit: memcached
spec:
  replicas: 1
  selector:
    matchLabels:
      app: memcached
  template:
    metadata:
      labels:
        app: memcached
        easydblab/kit: memcached
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: type
                    operator: In
                    values:
                      - db
      containers:
        - name: memcached
          image: memcached:1.6-alpine
          imagePullPolicy: IfNotPresent
          # The image entrypoint prepends `memcached` when the first arg is a flag.
          args:
            - -m
            - "__MEMORY_MB__"
          ports:
            - name: memcached
              containerPort: 11211
          readinessProbe:
            tcpSocket:
              port: 11211
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: 11211
            periodSeconds: 10
        - name: memcached-exporter
          image: prom/memcached-exporter:v0.15.0
          imagePullPolicy: IfNotPresent
          args:
            - --memcached.address=localhost:11211
            - --web.listen-address=:9150
          ports:
            - name: metrics
              containerPort: 9150
