    {
      "type": "timeseries",
      "title": "Heap: Used vs Committed vs Limit",
      "description": "Heap bytes used, committed by the JVM, and the maximum heap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by(host_name) (jvm_memory_used_bytes{job=\"neo4j\", cluster=~\"$cluster.*\", host_name=~\"$host\", jvm_memory_type=\"heap\"})",
          "legendFormat": "used {{host_name}}",
          "refId": "A"
        },
        {
          "expr": "sum by(host_name) (jvm_memory_committed_bytes{job=\"neo4j\", cluster=~\"$cluster.*\", host_name=~\"$host\", jvm_memory_type=\"heap\"})",
          "legendFormat": "committed {{host_name}}",
          "refId": "B"
        },
        {
          "expr": "sum by(host_name) (jvm_memory_limit_bytes{job=\"neo4j\", cluster=~\"$cluster.*\", host_name=~\"$host\", jvm_memory_type=\"heap\"})",
          "legendFormat": "limit {{host_name}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Non-Heap: Used vs Committed vs Limit",
