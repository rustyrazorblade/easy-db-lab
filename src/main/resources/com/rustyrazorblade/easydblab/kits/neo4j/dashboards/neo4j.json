{
  "uid": "neo4j-overview",
  "title": "Neo4j Overview",
  "description": "Neo4j Community from the OpenTelemetry Java agent: JVM memory, GC, CPU, threads and classes, HTTP API requests and latency, and WARN+ log records. Community Edition exposes no database-level metrics.",
  "tags": [
    "neo4j",
    "kit"
  ],
  "graphTooltip": 1,
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {
          "text": "Mimir",
          "value": "mimir"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(jvm_thread_count{job=\"neo4j\"}, cluster)",
        "hide": 0,
        "includeAll": false,
        "label": "Cluster",
        "multi": false,
        "name": "cluster",
        "options": [],
        "query": {
          "query": "label_values(jvm_thread_count{job=\"neo4j\"}, cluster)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(jvm_thread_count{job=\"neo4j\", cluster=~\"$cluster.*\"}, host_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": {
          "query": "label_values(jvm_thread_count{job=\"neo4j\", cluster=~\"$cluster.*\"}, host_name)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false
    },
    {
      "type": "text",
      "title": "About these metrics",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "mode": "markdown",
        "content": "**Neo4j Community Edition exposes no database-level metrics** (no transaction, page cache, Bolt or query metrics; those need Enterprise Edition). Everything here comes from the OpenTelemetry Java agent attached to the Neo4j JVM: JVM runtime metrics, HTTP API server instrumentation (Jetty), and WARN+ log records counted by the collector. Bolt traffic is not instrumented, so only HTTP API requests appear in the HTTP panels."
      }
    },
    {
      "type": "stat",
      "title": "Heap Used",
      "description": "Heap used as a share of the maximum heap (jvm_memory_used_bytes / jvm_memory_limit_bytes, type heap)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum(jvm_memory_used_bytes{job=\"neo4j\", cluster=~\"$cluster.*\", host_name=~\"$host\", jvm_memory_type=\"heap\"}) / sum(jvm_memory_limit_bytes{job=\"neo4j\", cluster=~\"$cluster.*\", host_name=~\"$host\", jvm_memory_type=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        }
      ]
    },
    {
