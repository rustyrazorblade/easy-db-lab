#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="__KUBECONFIG__"

echo "Stopping Presto..."
edl_scale_to_zero presto-coordinator presto-worker

echo "Presto stopped."
