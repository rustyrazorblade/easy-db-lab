#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="__KUBECONFIG__"

# Pinned: KitWorkloadProbe finds the release's pods by the
# app.kubernetes.io/instance=<release> label, verified for this chart version.
PRESTO_CHART_VERSION="0.4.0"

# No infrastructure-database catalog: prestodb ships no `opensearch` connector (its only
# search connector is `elasticsearch`), so there is no catalog to add for an OpenSearch domain.
edl_collect_catalogs presto "${SCRIPT_DIR}/../catalogs" "$(cd "${SCRIPT_DIR}/../.." && pwd)"
edl_helm_upgrade_with_catalogs presto prestodb/presto "${PRESTO_CHART_VERSION}" "${SCRIPT_DIR}/../values.yaml" catalog

# The coordinator uses hostPort 8080 and 9090. On a single app node a rolling update deadlocks:
# the new pod cannot bind the ports while the old pod holds them, so replace the pod instead.
edl_replace_hostport_pod 'app.kubernetes.io/name=presto,app.kubernetes.io/component=coordinator' presto-coordinator

echo "Presto catalog update complete."
