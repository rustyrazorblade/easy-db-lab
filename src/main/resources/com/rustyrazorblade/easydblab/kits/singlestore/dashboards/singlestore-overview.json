{
  "uid": "singlestore-overview",
  "title": "SingleStore Cluster Overview",
  "description": "SingleStore cluster health, queries, connections, memory, disk and replication, from the operator's exporter.",
  "tags": [
    "singlestore",
    "kit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "SingleStore Leaves and Partitions",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/singlestore-leaves/singlestore-leaves?from=${__from}&to=${__to}&${metrics_datasource:queryparam}&${cluster:queryparam}"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "metrics_datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_datasource}"
        },
        "regex": "/^(?<value>(?<text>.+?)(?:-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?)$/",
        "definition": "label_values(up, cluster)",
        "query": "label_values(up, cluster)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Exporter up",
      "description": "1 while the collector scrapes the operator's exporter sidecar in the master aggregator pod.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "label_replace(max by (cluster) (up{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Nodes reporting",
      "description": "SingleStore nodes the exporter reports: the master aggregator, the child aggregators and the leaves.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "label_replace(count by (cluster) (memsql_status_uptime{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Aggregators",
      "description": "The master aggregator (role MA) and the child aggregators (role CA).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "label_replace(count by (cluster) (memsql_status_uptime{cluster=~\"$cluster\", job=\"singlestore\", role=~\"MA|CA\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Leaves",
      "description": "Leaves the exporter reports, across every availability group.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "label_replace(count by (cluster) (memsql_status_uptime{cluster=~\"$cluster\", job=\"singlestore\", role=\"LEAF\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "row",
      "title": "Queries",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Queries by role (rate)",
      "description": "Statements per second, by node role (MA, CA, LEAF). A query on an aggregator fans out to the leaves.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, role) (rate(memsql_status_queries{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{role}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Successful reads and writes (rate)",
      "description": "Successful read and write queries per second, summed over every node.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_successful_read_queries{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} reads",
          "refId": "A"
        },
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_successful_write_queries{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} writes",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Failed reads and writes (rate)",
      "description": "Failed read and write queries per second, summed over every node.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_failed_read_queries{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} reads",
          "refId": "A"
        },
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_failed_write_queries{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} writes",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Connected threads by node",
      "description": "Open client connections on each node. Clients connect to the aggregators through the NodePort.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, host) (memsql_status_threads_connected{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Running threads by node",
      "description": "Threads executing a statement on each node.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, host) (memsql_status_threads_running{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "New and aborted connections (rate)",
      "description": "Connection attempts per second, and those that failed (bad password, network).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_connections{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} new",
          "refId": "A"
        },
        {
          "expr": "label_replace(sum by (cluster) (rate(memsql_status_aborted_connects{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} aborted",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Server memory by node",
      "description": "Memory each SingleStore node process holds, in MB.",
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(max by (cluster, host) (memsql_status_total_server_memory{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Table memory by node",
      "description": "Memory rowstore tables use on each node, in MB.",
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(max by (cluster, host) (memsql_status_alloc_table_memory{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Buffer manager memory by node",
      "description": "Memory the buffer manager holds on each node, in MB.",
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(max by (cluster, host) (memsql_status_buffer_manager_memory{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "row",
      "title": "Disk",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "Data mount used by db node",
      "description": "Bytes used on /mnt/db1, where the SingleStore data directory, its tracelogs and the pod logs live.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, host_name) (system_filesystem_usage_bytes{cluster=~\"$cluster\", state=\"used\", mountpoint=\"/mnt/db1\", host_name=~\"db[0-9]+\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Data mount free by db node",
      "description": "Bytes free on /mnt/db1 on each db node.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, host_name) (system_filesystem_usage_bytes{cluster=~\"$cluster\", state=\"free\", mountpoint=\"/mnt/db1\", host_name=~\"db[0-9]+\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{host_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "row",
      "title": "Replication",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "timeseries",
      "title": "Partitions online and offline",
      "description": "Database partitions, master and replica, that are online and offline. With redundancy 2 every partition has a replica in the other availability group.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster) (memsql_distributed_partitions_online{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} online",
          "refId": "A"
        },
        {
          "expr": "label_replace(sum by (cluster) (memsql_distributed_partitions_offline{cluster=~\"$cluster\", job=\"singlestore\"}), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} offline",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Rows written (rate)",
      "description": "Rows written per second, by node role. With redundancy 2 each leaf write is also replicated to its pair.",
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "label_replace(sum by (cluster, role) (rate(memsql_status_rows_affected_by_writes{cluster=~\"$cluster\", job=\"singlestore\"}[$__rate_interval])), \"cluster_name\", \"$1\", \"cluster\", \"(.+-[0-9a-f]{8})-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\")",
          "legendFormat": "{{cluster_name}} {{role}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      }
    }
  ]
}
