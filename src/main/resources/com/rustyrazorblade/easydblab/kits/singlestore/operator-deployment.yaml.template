# The SingleStore operator, taken from singlestore-labs/singlestore-helm
# (singlestore/templates/operator-deployment.yaml, commit 10a5743e). Changes from the chart: the
# image tag comes from --operator-version, the cluster id is the kit's MemsqlCluster name, and the
# pod is pinned to the control node, so no database node gives it CPU or memory.
#
# The pod carries no easydblab/kit label: the kit's runtime selector must match only the database
# pods a start creates, not the operator that install leaves running.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: singlestore-operator
  namespace: default
  labels:
    app.kubernetes.io/name: singlestore-operator
    app.kubernetes.io/component: operator
spec:
  replicas: 1
  selector:
    matchLabels:
      name: singlestore-operator
  template:
    metadata:
      labels:
        name: singlestore-operator
        app.kubernetes.io/name: singlestore-operator
    spec:
      serviceAccountName: singlestore-operator
      nodeSelector:
        node-role.kubernetes.io/control-plane: "true"
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: sdb-operator
          image: singlestore/operator:__OPERATOR_VERSION__
          imagePullPolicy: IfNotPresent
          args:
            - "--merge-service-annotations"
            - "--disable-finalizer"
            - "--fs-group-id"
            - "5555"
            - "--cluster-id"
            - "singlestore"
          env:
            - name: WATCH_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
