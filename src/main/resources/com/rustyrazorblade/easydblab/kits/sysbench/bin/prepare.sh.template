#!/usr/bin/env bash
set -euo pipefail

. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/target-db.sh
source "${SCRIPT_DIR}/lib/target-db.sh"

SYSBENCH_IMAGE="docker.io/severalnines/sysbench"
POD_NAME="sysbench-prepare-${KIT_NAME}-$(date +%s)"

# Runs pod $1 with role $2 and image $3 on an app node, then waits for it to end. Any arguments
# before `--` are extra `kubectl run` flags (such as --env); the command follows the `--`. Fails,
# with the pod's log, when it exits non-zero or its log holds a sysbench FATAL error, and deletes
# the pod when it succeeds.
run_to_completion() {
  local pod="$1" role="$2" image="$3" code log fatal
  shift 3
  local run_flags=()
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    run_flags+=("$1")
    shift
  done
  [ "$#" -gt 0 ] && shift
  kubectl --kubeconfig="${KUBECONFIG}" run "${pod}" \
    --image="${image}" \
    --restart=Never \
    --labels="$(edl_labels "${role}")" \
    --overrides="$(edl_pod_overrides)" \
    --override-type=strategic \
    ${run_flags[@]+"${run_flags[@]}"} \
    --command -- "$@"
  edl_wait_for_pod_running "${pod}"
  code="$(edl_wait_for_pod_exit "${pod}")"
  log="$(mktemp)"
  kubectl --kubeconfig="${KUBECONFIG}" logs "${pod}" > "${log}" 2>&1 || true
  fatal="$(sysbench_fatal_lines "${log}")"
  if [ "${code}" != 0 ]; then
    cat "${log}" >&2
    rm -f "${log}"
    edl_fail "pod ${pod} failed with exit code ${code}"
  fi
  if [ -n "${fatal}" ]; then
    cat "${log}" >&2
    rm -f "${log}"
    edl_fail "pod ${pod} hit a fatal SQL error:
${fatal}"
  fi
  rm -f "${log}"
  kubectl --kubeconfig="${KUBECONFIG}" delete pod "${pod}" --ignore-not-found
}

if ! target_db_args; then
  echo "Error: no supported database endpoint found. Ensure the target kit exposes a MySQL or PostgreSQL wire protocol endpoint." >&2
  exit 1
fi

edl_require_app_node sysbench

if [ -n "${TARGET_MYSQL_HOST:-}" ]; then
  # TiDB and MySQL do not ship with the sbtest database — create it before sysbench prepare. The
  # password reaches the mysql client through MYSQL_PWD, never its command line.
  target_mysql_pwd_env
  echo "Creating database ${TARGET_MYSQL_DATABASE} on ${TARGET_MYSQL_HOST}:${TARGET_MYSQL_PORT}..."
  run_to_completion "sysbench-createdb-${KIT_NAME}-$(date +%s)" sysbench-createdb "mysql:8.0" \
    ${MYSQL_PWD_ENV[@]+"${MYSQL_PWD_ENV[@]}"} \
    -- mysql \
    -h "${TARGET_MYSQL_HOST}" \
    -P "${TARGET_MYSQL_PORT}" \
    -u "${TARGET_MYSQL_USER}" \
    -e "CREATE DATABASE IF NOT EXISTS \`${TARGET_MYSQL_DATABASE}\`;"
fi

# Drop any pre-existing sbtest tables before preparing. sysbench prepare issues a
# plain CREATE TABLE, so re-preparing an existing dataset at a different --scale or
# --tables fails with "error 1050: Table 'sbtest.sbtest1' already exists". sysbench
# cleanup uses DROP TABLE IF EXISTS, so this is idempotent and safe on a fresh
# cluster with no existing tables. It runs for whichever driver (mysql/pgsql) was
# selected above via the shared DB_ARGS.
echo "Cleaning up any existing sysbench data before prepare..."
run_to_completion "sysbench-cleanup-${KIT_NAME}-$(date +%s)" sysbench-cleanup "${SYSBENCH_IMAGE}" \
  -- sysbench "${DB_ARGS[@]}" --tables="${TABLES}" "${WORKLOAD}" cleanup

echo "Preparing sysbench data: ${TABLES} tables, ${SCALE}000 rows each..."
run_to_completion "${POD_NAME}" sysbench-prepare "${SYSBENCH_IMAGE}" \
  -- sysbench "${DB_ARGS[@]}" --tables="${TABLES}" --table-size="${SCALE}000" "${WORKLOAD}" prepare

echo "Data preparation complete."
