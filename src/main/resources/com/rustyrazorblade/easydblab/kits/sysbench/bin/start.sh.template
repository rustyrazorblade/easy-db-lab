#!/usr/bin/env bash
set -euo pipefail

. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(dirname "${SCRIPT_DIR}")"
# shellcheck source=lib/target-db.sh
source "${SCRIPT_DIR}/lib/target-db.sh"
# Persist the final sysbench summary so a run's numbers survive after stdout scrolls away.
LAST_RUN_FILE="${KIT_DIR}/last-run.txt"

SYSBENCH_IMAGE="docker.io/severalnines/sysbench"
POD_NAME="sysbench-${KIT_NAME}-$(date +%s)"
LABELS="easydblab/kit=${KIT_NAME},easydblab/role=sysbench-run"

if ! target_db_args; then
  echo "Error: no supported database endpoint found. Ensure the target kit exposes a MySQL or PostgreSQL wire protocol endpoint." >&2
  exit 1
fi

edl_require_app_node sysbench
target_apply_credentials

echo "Starting sysbench: workload=${WORKLOAD}, threads=${THREADS}, duration=${DURATION}s..."

sysbench_command \
  --threads="${THREADS}" \
  --time="${DURATION}" \
  --rate="${RATE}" \
  --skip-trx="${SKIP_TRX}" \
  --rand-type="${RAND_TYPE}" \
  --report-interval=10 \
  --percentile=99 \
  --histogram \
  "${WORKLOAD}" run
OVERRIDES="$(target_pod_overrides "${POD_NAME}" "${SYSBENCH_PASSWORD_ENV}")"
kubectl --kubeconfig="${KUBECONFIG}" run "${POD_NAME}" \
  --image="${SYSBENCH_IMAGE}" \
  --restart=Never \
  --labels="${LABELS}" \
  --overrides="${OVERRIDES}" \
  --override-type=strategic \
  --command -- "${SYSBENCH_CMD[@]}"

edl_wait_for_pod_running "${POD_NAME}"

STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Echo every line and push each interval's stats to the collector. Interval lines match:
#   "[ Ns ] thds: N tps: N.NN qps: N.NN ... lat (ms,99%): N.NN err/s: N.NN ..."
# sysbench interval reports only ever emit the single configured percentile (99%),
# so p50/p95 cannot be derived per-interval. The live stream can repeat up to a second of lines
# when it resumes, so the summary and the whole-run percentiles come from the full log below.
handle_line() {
  local line="$1" tps qps lat err
  echo "${line}"
  if [[ "${line}" =~ ^\[\ [0-9]+s\ \] ]]; then
    read -r tps qps lat err <<< "$(echo "${line}" | awk '{
      for (i=1; i<=NF; i++) {
        if ($i == "tps:") tps=$(i+1)
        if ($i == "qps:") qps=$(i+1)
        if ($i == "err/s:") err=$(i+1)
        if ($i ~ /99%\):/) lat=$(i+1)
      }
      print tps, qps, lat, err
    }')"
    edl_push_gauges sysbench sysbench_tps "${tps:-0}" sysbench_qps "${qps:-0}" \
      sysbench_lat_p99_ms "${lat:-0}" sysbench_errors_per_second "${err:-0}"
  fi
  return 0
}
edl_follow_pod_logs "${POD_NAME}" handle_line
EXIT_CODE="$(edl_wait_for_pod_exit "${POD_NAME}")"

# The full log, read once the pod has ended, holds every line exactly once.
LOG_FILE="$(mktemp)"
kubectl --kubeconfig="${KUBECONFIG}" logs "${POD_NAME}" > "${LOG_FILE}" 2>&1 || true
FATAL_LINES="$(sysbench_fatal_lines "${LOG_FILE}")"

# Persist the run metadata, the exit code and the final sysbench report (SQL statistics /
# Throughput / Latency percentiles / errors), which starts at "SQL statistics:" and runs to the end
# of the log. Every ended run replaces the file, a failed one too, so it never shows an older run;
# a run that printed no report keeps the end of its log instead.
{
  echo "sysbench run summary"
  echo "workload:  ${WORKLOAD}"
  echo "threads:   ${THREADS}"
  echo "duration:  ${DURATION}s"
  echo "rate:      ${RATE}"
  echo "skip-trx:  ${SKIP_TRX}"
  echo "rand-type: ${RAND_TYPE}"
  echo "started:   ${STARTED}"
  echo "exit code: ${EXIT_CODE}"
  echo
  if [ -n "${FATAL_LINES}" ]; then
    echo "fatal errors:"
    printf '%s\n' "${FATAL_LINES}"
    echo
  fi
  if grep -q '^SQL statistics:' "${LOG_FILE}"; then
    awk '/^SQL statistics:/ { insummary = 1 } insummary' "${LOG_FILE}"
  else
    echo "The run printed no summary. The end of its log:"
    tail -n 20 "${LOG_FILE}"
  fi
} > "${LAST_RUN_FILE}"

if [ "${EXIT_CODE}" != 0 ]; then
  rm -f "${LOG_FILE}"
  edl_fail "The sysbench run failed with exit code ${EXIT_CODE}. Its settings and log are in ${LAST_RUN_FILE}"
fi

# A fatal SQL error fails the run whatever the exit code: sysbench stops the thread that hit it.
if [ -n "${FATAL_LINES}" ]; then
  rm -f "${LOG_FILE}"
  edl_fail "The sysbench run hit a fatal SQL error:
${FATAL_LINES}
Its settings and log are in ${LAST_RUN_FILE}"
fi

# Derive whole-run p50/p95/p99 from the final latency histogram (values in ms).
# Histogram data lines look like: "       1.412 |***...     123" — first field is
# the bucket value, last field is the count. Percentiles are the bucket value at
# which the cumulative count first crosses the target fraction of the total.
read -r P50 P95 P99 <<< "$(awk '
  /Latency histogram/ { inhist = 1; next }
  inhist && /^[[:space:]]*[0-9.]+[[:space:]]*\|/ {
    val[++n] = $1; cnt[n] = $NF; total += $NF
  }
  END {
    if (total == 0) { print "0 0 0"; exit }
    c = 0
    for (i = 1; i <= n; i++) {
      c += cnt[i]
      if (p50 == "" && c >= 0.50 * total) p50 = val[i]
      if (p95 == "" && c >= 0.95 * total) p95 = val[i]
      if (p99 == "" && c >= 0.99 * total) p99 = val[i]
    }
    print p50, p95, p99
  }
' "${LOG_FILE}")"
edl_push_gauges sysbench sysbench_lat_p50_ms "${P50:-0}" sysbench_lat_p95_ms "${P95:-0}" sysbench_lat_p99_ms "${P99:-0}"
rm -f "${LOG_FILE}"

echo "Run summary written to ${LAST_RUN_FILE}"
