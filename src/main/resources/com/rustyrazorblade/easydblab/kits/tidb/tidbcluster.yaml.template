apiVersion: pingcap.com/v1alpha1
kind: TidbCluster
metadata:
  name: tidb
  namespace: default
spec:
  version: "__TIDB_VERSION__"
  timezone: UTC
  # Keep the volumes when a claim goes away: they hold the owner's data. On local volumes,
  # uninstall's kit-storage-delete removes the PVs and their directories.
  pvReclaimPolicy: Retain
  enableDynamicConfiguration: true
  # Roll pods when spec.<component>.config changes; the default InPlace only updates
  # the ConfigMap and never restarts TiKV, so config changes would silently not apply.
  configUpdateStrategy: RollingUpdate

  pd:
    # PD's start script resolves its own name with `nslookup`. Ubuntu ships a host AppArmor profile
    # for /usr/bin/nslookup, and under the node's default container profile (containerd's, stacked
    # with the host's) it refuses the signals nslookup's own threads send each other, so nslookup
    # segfaults, the script never finishes and PD crash-loops. The TidbCluster CRD prunes
    # `appArmorProfile` from its pod security context, so the container is set unconfined through
    # the annotation the API server converts to the pod field (deprecated since Kubernetes 1.30 but
    # still converted on the 1.35 K3s in the AMI; revisit when the operator's CRD keeps the field).
    # The operator copies the annotation only when it creates the StatefulSet.
    annotations:
      container.apparmor.security.beta.kubernetes.io/pd: unconfined
    baseImage: pingcap/pd
    replicas: 1
    requests:
      storage: __STORAGE_SIZE__
    storageClassName: __KIT_STORAGE_CLASS__
    config: {}
    nodeSelector: __APP_NODE_SELECTOR__

  tidb:
    baseImage: pingcap/tidb
    replicas: __APP_NODE_COUNT__
    service:
      type: ClusterIP
    # TiDB v8.x has no native OTel support. Traces are exported via the built-in OpenTracing
    # Jaeger reporter to the OTel Collector (UDP 6831), which translates them to OTLP and
    # forwards to Tempo. The `opentelemetry.*` config keys do not exist in v8.x and will be
    # rejected at startup — use [opentracing] instead.
    config: |
      [noop]
        enable-noop-functions = true
      [prepared-plan-cache]
        enabled = true
      [stmt-summary]
        enable = true
      [tikv-client]
        grpc-connection-count = 4
      [opentracing]
        enable = true
      [opentracing.sampler]
        type = "const"
        param = 1.0
      [opentracing.reporter]
        local-agent-host-port = "__OTEL_COLLECTOR_HOST__:6831"
    nodeSelector: __APP_NODE_SELECTOR__

  tikv:
    baseImage: pingcap/tikv
    replicas: __REPLICAS__
    requests:
      storage: __STORAGE_SIZE__
    storageClassName: __KIT_STORAGE_CLASS__
    config: {}
    nodeSelector: __DB_NODE_SELECTOR__

  tiflash:
    baseImage: pingcap/tiflash
    replicas: __REPLICAS__
    storageClaims:
      - resources:
          requests:
            storage: __STORAGE_SIZE__
        storageClassName: __KIT_STORAGE_CLASS__
    nodeSelector: __DB_NODE_SELECTOR__
