#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="${SCRIPT_DIR}/../../__KUBECONFIG__"

CLUSTER_LABEL="$(edl_cluster_label)"

echo "Installing Trino..."
helm repo add trinodb https://trinodb.github.io/charts 2>/dev/null || true

# Install and configure catalogs in one step (update-catalogs.sh owns the helm install)
"${SCRIPT_DIR}/update-catalogs.sh"

echo "Patching coordinator: Pyroscope profiling agent..."
edl_patch_pyroscope trino-coordinator trino-coordinator trino "${CLUSTER_LABEL}" coordinator

echo "Patching worker: Pyroscope profiling agent..."
edl_patch_pyroscope trino-worker trino-worker trino "${CLUSTER_LABEL}" worker

echo "Waiting for rollout to complete..."
kubectl rollout status deployment/trino-coordinator --namespace default --timeout=180s
kubectl rollout status deployment/trino-worker --namespace default --timeout=180s

# Clients reach the coordinator through its NodePort Service on any node; the pod declares no hostPort.
echo "Publishing the coordinator on its NodePort Service..."
kubectl apply -f - < "${SCRIPT_DIR}/../nodeport-service.yaml"

echo "Trino is ready. Workers: __WORKERS__"
