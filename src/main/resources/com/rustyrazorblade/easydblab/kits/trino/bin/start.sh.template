#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="${KUBECONFIG:?run this through easy-db-lab, which sets KUBECONFIG}"

CLUSTER_LABEL="$(edl_cluster_label)"

echo "Installing Trino..."
helm repo add trinodb https://trinodb.github.io/charts 2>/dev/null || true

# Install and configure catalogs in one step (update-catalogs.sh owns the helm install)
"${SCRIPT_DIR}/update-catalogs.sh"

echo "Patching coordinator: hostPort + Pyroscope profiling agent..."
edl_patch_pyroscope trino-coordinator trino-coordinator trino "${CLUSTER_LABEL}" coordinator 8080

echo "Patching worker: Pyroscope profiling agent..."
edl_patch_pyroscope trino-worker trino-worker trino "${CLUSTER_LABEL}" worker

echo "Waiting for rollout to complete..."
# Replace the coordinator pod explicitly: a rolling restart fails with hostPort conflicts when
# only one app node is available. The replacement picks up ConfigMap changes.
edl_replace_hostport_pod 'app.kubernetes.io/name=trino,app.kubernetes.io/component=coordinator' trino-coordinator
kubectl rollout status deployment/trino-worker --namespace default --timeout=180s

echo "Trino is ready. Workers: __WORKERS__"
