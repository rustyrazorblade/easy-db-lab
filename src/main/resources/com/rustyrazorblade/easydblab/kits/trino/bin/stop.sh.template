#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="${KUBECONFIG:?run this through easy-db-lab, which sets KUBECONFIG}"

echo "Stopping Trino..."
edl_scale_to_zero trino-coordinator trino-worker

echo "Trino stopped."
