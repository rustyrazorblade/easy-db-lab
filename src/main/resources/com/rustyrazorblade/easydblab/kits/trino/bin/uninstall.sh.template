#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="${SCRIPT_DIR}/../../__KUBECONFIG__"

echo "Uninstalling Trino..."
edl_helm_uninstall trino
# start applies the NodePort Service with kubectl, outside the helm release.
kubectl delete service trino-nodeport --namespace default --ignore-not-found

echo "Trino uninstalled."
