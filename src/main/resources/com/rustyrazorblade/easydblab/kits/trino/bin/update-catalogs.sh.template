#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${EDL_KIT_LIB:?run this through easy-db-lab, which sets EDL_KIT_LIB}"
export KUBECONFIG="${SCRIPT_DIR}/../../__KUBECONFIG__"

# Pinned: KitWorkloadProbe finds the release's pods by the
# app.kubernetes.io/instance=<release> label, verified for this chart version.
TRINO_CHART_VERSION="1.42.2"

# opensearch is an infrastructure database, not a kit: its catalog is added when the endpoint is known.
edl_collect_catalogs trino "${SCRIPT_DIR}/../catalogs" "$(cd "${SCRIPT_DIR}/../.." && pwd)" opensearch
edl_helm_upgrade_with_catalogs trino trinodb/trino "${TRINO_CHART_VERSION}" "${SCRIPT_DIR}/../values.yaml" additionalCatalogs

# The coordinator uses hostPort 8080. On a single app node a rolling update deadlocks: the new pod
# cannot bind the port while the old pod holds it, so replace the pod instead.
edl_replace_hostport_pod 'app.kubernetes.io/name=trino,app.kubernetes.io/component=coordinator' trino-coordinator

echo "Trino catalog update complete."
