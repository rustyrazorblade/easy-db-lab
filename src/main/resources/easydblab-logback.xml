<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${EASY_DB_LAB_LOG_DIR:-${EASY_DB_LAB_USER_DIR:-${user.home}/.easy-db-lab}/logs}" />

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/info.log</file>
        <encoder>
            <pattern>%d %p %C{1} [%t] %m%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/debug.log</file>
        <encoder>
            <pattern>%d %p %C{1} [%t] %m%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/debug.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <!-- Note: Log instrumentation is handled automatically by the OpenTelemetry Java agent -->

    <!--
      Apache MINA logs every remote command verbatim at DEBUG ("send SSH_MSG_CHANNEL_REQUEST exec
      command={}"), one layer below where this codebase redacts. A remote command legitimately
      carries a git URL with an embedded token, so at DEBUG that credential would land unredacted
      in debug.log and its 30 days of gzipped archives. Narrowed to INFO: this silences only the
      SSH transport's own chatter, not application debug logging.
    -->
    <logger name="org.apache.sshd" level="INFO" />

    <!--
      HTTP wire and header logging writes requests and responses verbatim: the SSO bearer token
      (x-amz-sso_bearer_token), Authorization headers, the role credentials the SSO portal returns,
      and the account ID in query strings. These loggers carry nothing else (okhttp3.OkHttpClient is
      where OkHttp's HttpLoggingInterceptor writes by default), so they are off at
      every level; each library's other debug logging is kept. Add any new HTTP client's wire or
      header logger here (LogbackConfigurationTest checks the list).
    -->
    <logger name="org.apache.http.wire" level="OFF" />
    <logger name="org.apache.http.headers" level="OFF" />
    <logger name="org.apache.hc.client5.http.wire" level="OFF" />
    <logger name="org.apache.hc.client5.http.headers" level="OFF" />
    <logger name="org.apache.hc.core5.http2.frame" level="OFF" />
    <logger name="software.amazon.awssdk.request" level="OFF" />
    <!-- The SigV4 signers log the canonical request, which carries the x-amz-security-token value. -->
    <logger name="software.amazon.awssdk.http.auth.aws.internal.signer" level="OFF" />
    <logger name="software.amazon.awssdk.auth.signer" level="OFF" />
    <!-- Request lines carry the query string, such as the SSO credentials call's account_id. -->
    <logger name="org.apache.hc.client5.http.impl.classic.MainClientExec" level="OFF" />
    <logger name="org.apache.hc.client5.http.impl.async.HttpAsyncMainClientExec" level="OFF" />
    <logger name="org.apache.http.impl.execchain.MainClientExec" level="OFF" />
    <logger name="okhttp3.OkHttpClient" level="OFF" />
    <logger name="io.fabric8.kubernetes.client.http.HttpLoggingInterceptor" level="OFF" />
    <logger name="io.netty.handler.logging" level="OFF" />

    <root level="DEBUG">
        <appender-ref ref="INFO_FILE" />
        <appender-ref ref="DEBUG_FILE" />
    </root>
</configuration>
